{
  "name": "chats-dashboard",
  "private": true,
  "version": "0.1.0",
  "description": "Local, read-only live dashboard of your Claude Code and Codex CLI chats.",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --no-warnings --test \"test/*.test.mjs\"",
    "start": "node --disable-warning=ExperimentalWarning server/server.mjs --open",
    "relay": "node relay-cli.mjs",
    "install:relay": "node scripts/install-relay.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "lucide-react": "1.53.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
